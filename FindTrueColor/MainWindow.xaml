<Window x:Class="FindTrueColor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FindTrueColor"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="#FF23272F">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="126*"/>
            <ColumnDefinition Width="65*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,10,0" Grid.ColumnSpan="2">
            <ScrollViewer>
                <Image x:Name="imgSnip" Stretch="Uniform" MouseLeftButtonDown="imgSnip_MouseLeftButtonDown"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="2">
            <WrapPanel Margin="0,0,0,10">
                <Button Style="{StaticResource ModernColorButton}" local:ButtonHelper.CornerRadius="5" 
                        Width="120" Height="32" Margin="0,0,5,0" Content="Snip Area" Click="BtnSnip_Click"/>
                <Button Style="{StaticResource ModernColorButton}" local:ButtonHelper.CornerRadius="5"
                        Width="120" Height="32" Margin="0,0,4,0" Content="Average" Click="BtnAverage_Click"/>
                <Button Width="5" Height="32" Content="Coming &#10;   soon" Click="BtnChoosePixel_Click"/>
            </WrapPanel>

            <Border Width="100" Height="100" BorderBrush="White" BorderThickness="1" x:Name="bdColor"/>

            <TextBlock x:Name="txtRgb" Margin="0,10,0,0" FontSize="14" Foreground="White"/>
            <TextBlock x:Name="txtHex" FontSize="14" Foreground="White"/>

            <TextBlock Margin="0,14,0,4" Text="Convert To" FontWeight="Bold" Foreground="White"/>
            <!-- removed SelectedIndex and SelectionChanged wiring from XAML to avoid firing during InitializeComponent -->
            <ComboBox x:Name="cbMode">
                <ComboBoxItem Content="CMYK"/>
                <ComboBoxItem Content="HSV"/>
                <ComboBoxItem Content="HSV (HALCON)"/>
            </ComboBox>

            <TextBlock x:Name="txtConvert1" Margin="0,10,0,0" FontSize="14" Foreground="White"/>
            <TextBlock x:Name="txtConvert2" FontSize="14" Foreground="White"/>
            <TextBlock x:Name="txtConvert3" FontSize="14" Foreground="White"/>
            <TextBlock x:Name="txtConvert4" FontSize="14" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
